[Unit]
Description=Lectigo yt-dlp backend
After=network.target

[Service]
Type=simple
User=lectigo
WorkingDirectory=/opt/lectigo/backend
EnvironmentFile=/opt/lectigo/backend/.env
ExecStart=/opt/lectigo/backend/.venv/bin/uvicorn app.main:app --host ${LECTIGO_HOST} --port ${LECTIGO_PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
